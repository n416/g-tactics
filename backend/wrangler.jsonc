{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "g-tactics",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-02",
  // "compatibility_flags": [
  //   "nodejs_compat"
  // ],
  "vars": {
    // Google OAuth のクライアントID。これは公開情報（同意画面へのURLに載ってブラウザに出る）
    // なのでリポジトリに置いてよい。対になる GOOGLE_CLIENT_SECRET は秘密なので
    // `npx wrangler secret put GOOGLE_CLIENT_SECRET` で入れること（ここには絶対に書かない）。
    "GOOGLE_CLIENT_ID": "716275360793-uuubfea5mj9lemem1n5o1ja2seksbblt.apps.googleusercontent.com"
  },
  // "kv_namespaces": [
  //   {
  //     "binding": "MY_KV_NAMESPACE",
  //     "id": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
  //   }
  // ],
  // フロントエンド(React)のビルド成果物を同じ Worker から配信する。
  // - run_worker_first: /api/* は API、/images/units/* は R2 配信のため Worker を先に通す。
  //   それ以外は静的アセットを直接返す（Worker は起動しない）。
  // - not_found_handling: SPA なので未知のパスは index.html を返す（React Router が処理）。
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/images/units/*"]
  },
  // 機体画像。リポジトリに含めず R2 に置くことで、デプロイのたびに消えないようにする。
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "g-tactics-assets"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gtactics-db",
      "database_id": "ff0117cd-46bf-4983-b5eb-7c9dc22273e8"
    }
  ],
  // "ai": {
  //   "binding": "AI"
  // },
  // "observability": {
  //   "enabled": true,
  //   "head_sampling_rate": 1
  // }
}