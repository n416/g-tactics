{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "npm --prefix ../frontend run build && wrangler deploy --minify",
    "deploy:worker-only": "wrangler deploy --minify",
    "preflight": "node scripts/preflight.mjs",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "seed:teams": "node scripts/seed_dev_teams.mjs",
    "admin": "node scripts/make_admin.mjs"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.8.0",
    "hono": "^4.12.27",
    "iconv-lite": "^0.7.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.0",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.11.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.4.0"
  }
}
